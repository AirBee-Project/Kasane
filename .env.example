# Kasane の環境変数一覧。`.env` へコピーして使う。値はすべて既定値。

# --- 基本 ---
PORT=5172
# 書き込みを 1 トランザクションへ畳む上限。1 で畳み込みを無効化。
# KASANE_WRITE_BATCH=256

# Queryの同時実行数上限
# KASANE_QUERY_CONCURRENCY=8

# --- LMDB ---
DATABASE_DIR=default_kasane_db
# KASANE_LMDB_MAP_SIZE=10737418240
# KASANE_LMDB_MAX_READERS=1024
# KASANE_LMDB_NO_READAHEAD=1
# 以下 2 つは耐久性と引き換えの設定。
# KASANE_LMDB_WRITE_MAP=1
# KASANE_LMDB_NO_SYNC=1

# --- TiKV ---
# PD の宛先。複数台はカンマ区切り（例: 10.0.0.1:2379,10.0.0.2:2379）。
KASANE_TIKV_PD_ENDPOINTS=127.0.0.1:2379
# 1 回の RPC に与える時間（秒）。短いと混雑時に打ち切られて失敗に化ける。
# KASANE_TIKV_REQUEST_TIMEOUT_SECS=30
# gRPC が 1 メッセージとして受け取れる最大バイト数。tikv-client の既定は 4MiB で、
# 値の大きいシャードが絡む応答だとこれを超えて失敗しうる。内部のバッチ分割で
# 1 RPC あたりのバイト量は既に抑えてあるが、これはそれとは独立な多重防御。
# KASANE_TIKV_GRPC_MAX_DECODING_MESSAGE_SIZE=16777216
# ca.crt / client.crt / client.key を置いたディレクトリ。未設定なら平文接続。
# KASANE_TIKV_TLS_DIR=/etc/kasane/tls
# 削除済みテーブルの実体を回収する間隔（秒）。0 で回収しない（容量が解放されない）。
# KASANE_TIKV_GC_INTERVAL_SECS=60
# MVCC の古い版を残す時間（秒）。実行中の読み取りより長くすること。
# 0 で MVCC GC を止める（全バージョンが永久に残る）。
# KASANE_TIKV_MVCC_GC_RETENTION_SECS=600
# docker compose が TiKV へ渡す deployment/ 内のファイル名（パスではない）。
# KASANE_TIKV_CONFIG=tikv.toml

# --- ログ・トレース ---
# plain または json。
KASANE_LOG_FORMAT=json
RUST_LOG=info,kasane=info,kasane_logic=debug,tikv_client=warn,tower_http=info,axum_tracing_opentelemetry=error,otel::tracing=info
# 送信先の OTLP コレクター。未設定ならトレースを送らない。
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318/v1/traces"
# OTEL_EXPORTER_OTLP_HEADERS="api-key=xxxx"
# サンプリングレート（0.0 ~ 1.0）。
# OTEL_TRACES_SAMPLER_ARG=0.1
# 実行環境のメタデータ。
# CLOUD_REGION=ap-northeast-1
# CLOUD_AVAILABILITY_ZONE=ap-northeast-1a
# CLOUD_PROVIDER=aws
# DEPLOYMENT_ENVIRONMENT_NAME=staging
# HOST_NAME=kasane-server-01

# --- 認証 ---
# 初回起動時に作る root のパスワード。初期化済みのデータベースには効かない。
ROOT_PASSWORD=password
# 未設定だと起動ごとにランダム鍵を生成し、再起動で発行済みトークンが全無効になる。
JWT_SECRET=kasane-super-secret-key-change-me
