# Kasane の環境変数一覧。`.env` へコピーして使う。値はすべて既定値。

# --- 基本 ---
# サーバーの待ち受けポート（gRPC および grpc-web）。
PORT=5172
# 書き込みを 1 トランザクションへ畳む上限。1 で畳み込みを無効化。
# KASANE_WRITE_BATCH=256

# Queryの同時実行数上限
# KASANE_QUERY_CONCURRENCY=8

# --- LMDB ---
DATABASE_DIR=default_kasane_db
# KASANE_LMDB_MAP_SIZE=10737418240
# KASANE_LMDB_MAX_READERS=1024
# KASANE_LMDB_NO_READAHEAD=1
# 以下 2 つは耐久性と引き換えの設定。
# KASANE_LMDB_WRITE_MAP=1
# KASANE_LMDB_NO_SYNC=1

# --- ログ ---
# plain または json。
KASANE_LOG_FORMAT=json
RUST_LOG=info,kasane=info,spatial_id=debug,tower_http=info

# --- 認証 ---
# 初回起動時に作る root のパスワード。初期化済みのデータベースには効かない。
ROOT_PASSWORD=password
# 未設定だと起動ごとにランダム鍵を生成し、再起動で発行済みトークンが全無効になる。
JWT_SECRET=kasane-super-secret-key-change-me
