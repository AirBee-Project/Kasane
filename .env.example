# ==========================================
# 基本設定
# ==========================================

# APIサーバーのポート（未指定時は 5172）
PORT=5172

# ==========================================
# ストレージバックエンド
# ==========================================
# --- LMDB---
DATABASE_DIR=default_kasane_db
# KASANE_LMDB_MAP_SIZE=10737418240
# KASANE_LMDB_MAX_READERS=1024
# KASANE_LMDB_NO_READAHEAD=1
# 書き込み可能なmmapの有効化（危険かも）
# KASANE_LMDB_WRITE_MAP=1
# コミット毎のfsyncの省略（危険かも）
# KASANE_LMDB_NO_SYNC=1

# --- TiKV ---
# `docker compose up -d` で立ち上がる PD の宛先。コード側の既定値と同じなので、
# 未設定でも同じ場所へ繋がる。
KASANE_TIKV_PD_ENDPOINTS=127.0.0.1:2379
# 1 回の TiKV RPC に与える時間（秒）。既定 30。
# tikv-client の既定は 2 秒で、混み合うと batch_get や prewrite が普通に超える。
# 超えた RPC は打ち切られ、TiKV 側に RemoteStopped として現れる。
# KASANE_TIKV_REQUEST_TIMEOUT_SECS=30
# KASANE_TIKV_CA_PATH=/etc/kasane/tls/ca.crt
# KASANE_TIKV_CERT_PATH=/etc/kasane/tls/client.crt
# KASANE_TIKV_KEY_PATH=/etc/kasane/tls/client.key

# ==========================================
# OpenTelemetry
# ==========================================
# ログの出力形式（`plain` または `json`。未指定時は `plain`）
KASANE_LOG_FORMAT=json

# ログの出力レベル
RUST_LOG=info,kasane=info,tower_http=info,axum_tracing_opentelemetry=error,otel::tracing=info

# トレースを送信するOTLPコレクター（`docker compose` の Jaeger）。
# 収集したトレースは http://127.0.0.1:16686 で見られる。
# 未設定ならトレースの送信自体を行わない。
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318/v1/traces"

# 送信時に付与する認証ヘッダー
# OTEL_EXPORTER_OTLP_HEADERS="api-key=xxxx"

# トレースのサンプリングレート（0.0 ~ 1.0）。
# OTEL_TRACES_SAMPLER_ARG=0.1

# 実行環境のメタデータ
# CLOUD_REGION=ap-northeast-1
# CLOUD_AVAILABILITY_ZONE=ap-northeast-1a
# CLOUD_PROVIDER=aws
# DEPLOYMENT_ENVIRONMENT_NAME=staging
# HOST_NAME=kasane-server-01

# ==========================================
# セキュリティ・認証
# ==========================================
ROOT_PASSWORD=password
JWT_SECRET=kasane-super-secret-key-change-me
