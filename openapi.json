{
  "openapi": "3.1.0",
  "info": {
    "title": "kasane",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/databases": {
      "get": {
        "tags": [
          "databases"
        ],
        "operationId": "database_list",
        "responses": {
          "200": {
            "description": "List databases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DatabaseInfoResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "databases"
        ],
        "operationId": "database_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDatabaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/databases/{db_name}/tables": {
      "get": {
        "tags": [
          "tables"
        ],
        "operationId": "table_list",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tables",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tables"
        ],
        "operationId": "table_create",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Table created"
          },
          "400": {
            "description": "Invalid request"
          },
          "409": {
            "description": "Table already exists"
          }
        }
      }
    },
    "/databases/{db_name}/tables/{table_name}": {
      "get": {
        "tags": [
          "tables"
        ],
        "operationId": "table_info",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableInfoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Table not found"
          }
        }
      },
      "delete": {
        "tags": [
          "tables"
        ],
        "operationId": "table_remove",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table removed"
          },
          "404": {
            "description": "Table not found"
          }
        }
      }
    },
    "/databases/{db_name}/tables/{table_name}/data": {
      "put": {
        "tags": [
          "tables"
        ],
        "operationId": "data_insert",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Data inserted"
          },
          "404": {
            "description": "Table not found"
          }
        }
      },
      "delete": {
        "tags": [
          "tables"
        ],
        "operationId": "data_remove",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Data removed"
          },
          "404": {
            "description": "Table not found"
          }
        }
      },
      "patch": {
        "tags": [
          "tables"
        ],
        "operationId": "data_upsert",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InsertDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Data upserted"
          },
          "404": {
            "description": "Table not found"
          }
        }
      }
    },
    "/databases/{db_name}/tables/{table_name}/data/search": {
      "post": {
        "tags": [
          "tables"
        ],
        "operationId": "data_get",
        "parameters": [
          {
            "name": "db_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Data retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataResponse"
                }
              }
            }
          },
          "404": {
            "description": "Table not found"
          }
        }
      }
    },
    "/databases/{name}": {
      "get": {
        "tags": [
          "databases"
        ],
        "operationId": "database_info",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get database info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatabaseInfoResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "databases"
        ],
        "operationId": "database_remove",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDatabaseRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "description": "時空間IDと値が対応するTableを作成する",
        "required": [
          "name",
          "data_type",
          "max_zoom_level"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "example_table"
          },
          "data_type": {
            "$ref": "#/components/schemas/TableDataType"
          },
          "max_zoom_level": {
            "type": "integer",
            "format": "int32",
            "example": 25,
            "maximum": 30,
            "minimum": 0
          }
        }
      },
      "DatabaseInfoResponse": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Geometry": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "zoomlevel",
              "coordinate",
              "type"
            ],
            "properties": {
              "zoomlevel": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "coordinate": {
                "$ref": "#/components/schemas/PointCoordinate"
              },
              "type": {
                "type": "string",
                "enum": [
                  "coordinate"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "zoomlevel",
              "points",
              "type"
            ],
            "properties": {
              "zoomlevel": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PointCoordinate"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "line"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "zoomlevel",
              "points",
              "type"
            ],
            "properties": {
              "zoomlevel": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PointCoordinate"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "triangle"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "zoomlevel",
              "radius_m",
              "center",
              "type"
            ],
            "properties": {
              "zoomlevel": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "radius_m": {
                "type": "number",
                "format": "double"
              },
              "center": {
                "$ref": "#/components/schemas/PointCoordinate"
              },
              "type": {
                "type": "string",
                "enum": [
                  "sphere"
                ]
              }
            }
          }
        ]
      },
      "GetDataRequest": {
        "type": "object",
        "description": "空間IDの範囲を[Query]で指定して値を取得する",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "zoom_level_policy": {
            "$ref": "#/components/schemas/ZoomLevelPolicy"
          }
        }
      },
      "GetDataResponse": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpatialData"
            }
          }
        }
      },
      "InsertDataRequest": {
        "type": "object",
        "description": "空間IDの範囲を指定して値を挿入する",
        "required": [
          "value",
          "query"
        ],
        "properties": {
          "value": {},
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "zoom_level_policy": {
            "$ref": "#/components/schemas/ZoomLevelPolicy"
          }
        }
      },
      "PointCoordinate": {
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "altitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "altitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Query": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ids",
              "type"
            ],
            "properties": {
              "ids": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SpatialId"
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "spatialIds"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "geometry",
              "type"
            ],
            "properties": {
              "geometry": {
                "$ref": "#/components/schemas/Geometry"
              },
              "type": {
                "type": "string",
                "enum": [
                  "geometry"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "left",
              "right",
              "type"
            ],
            "properties": {
              "left": {
                "$ref": "#/components/schemas/Query"
              },
              "right": {
                "$ref": "#/components/schemas/Query"
              },
              "type": {
                "type": "string",
                "enum": [
                  "union"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "left",
              "right",
              "type"
            ],
            "properties": {
              "left": {
                "$ref": "#/components/schemas/Query"
              },
              "right": {
                "$ref": "#/components/schemas/Query"
              },
              "type": {
                "type": "string",
                "enum": [
                  "intersection"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "base",
              "subtract",
              "type"
            ],
            "properties": {
              "base": {
                "$ref": "#/components/schemas/Query"
              },
              "subtract": {
                "$ref": "#/components/schemas/Query"
              },
              "type": {
                "type": "string",
                "enum": [
                  "difference"
                ]
              }
            }
          }
        ]
      },
      "RangeId": {
        "type": "object",
        "required": [
          "z",
          "f",
          "x",
          "y"
        ],
        "properties": {
          "z": {
            "type": "integer",
            "format": "int32",
            "example": 20,
            "maximum": 30,
            "minimum": 0
          },
          "f": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "example": [
              0,
              0
            ]
          },
          "x": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "example": [
              931388,
              931390
            ]
          },
          "y": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "example": [
              412900,
              412907
            ]
          }
        }
      },
      "RemoveDataRequest": {
        "type": "object",
        "description": "空間IDの範囲を指定して値を削除する",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "zoom_level_policy": {
            "$ref": "#/components/schemas/ZoomLevelPolicy"
          }
        }
      },
      "SingleId": {
        "type": "object",
        "required": [
          "z",
          "f",
          "x",
          "y"
        ],
        "properties": {
          "z": {
            "type": "integer",
            "format": "int32",
            "example": 20,
            "maximum": 30,
            "minimum": 0
          },
          "f": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "x": {
            "type": "integer",
            "format": "int32",
            "example": 931386,
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "format": "int32",
            "example": 412905,
            "minimum": 0
          }
        }
      },
      "SpatialData": {
        "type": "object",
        "required": [
          "id",
          "data"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/SingleId"
          },
          "data": {}
        }
      },
      "SpatialId": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/SingleId"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "singleId"
                    ]
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/RangeId"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "rangeId"
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      "TableDataType": {
        "type": "string",
        "description": "Table内の時空間IDに付与する値の型。",
        "enum": [
          "Text",
          "Int",
          "Float",
          "Boolean"
        ]
      },
      "TableFilter": {
        "type": "object",
        "required": [
          "name",
          "query"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "query": {
            "$ref": "#/components/schemas/TableFilterType"
          }
        }
      },
      "TableFilterBoolean": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "boolean"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              }
            }
          }
        ]
      },
      "TableFilterFloat": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "number",
                "format": "float"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "number",
                "format": "float"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "notEqual"
                ]
              }
            }
          }
        ]
      },
      "TableFilterInt": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "format": "int32"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "format": "int32"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "notEqual"
                ]
              }
            }
          }
        ]
      },
      "TableFilterText": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "notEqual"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "startsWith"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "operator"
            ],
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operator": {
                "type": "string",
                "enum": [
                  "in"
                ]
              }
            }
          }
        ]
      },
      "TableFilterType": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TableFilterText"
          },
          {
            "$ref": "#/components/schemas/TableFilterInt"
          },
          {
            "$ref": "#/components/schemas/TableFilterFloat"
          },
          {
            "$ref": "#/components/schemas/TableFilterBoolean"
          }
        ]
      },
      "TableInfoResponse": {
        "type": "object",
        "required": [
          "name",
          "data_type",
          "max_zoom_level"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "example_table"
          },
          "data_type": {
            "$ref": "#/components/schemas/TableDataType"
          },
          "max_zoom_level": {
            "type": "integer",
            "format": "int32",
            "example": 25,
            "minimum": 0
          }
        }
      },
      "TableListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TableInfoResponse"
        }
      },
